{
  "name": "workouts",
  "version": "1.0",
  "description": "Workout logging and summaries",
  "tools": [
    {
      "name": "workouts.log_workout",
      "description": "Log a workout entry to Supabase",
      "input_schema": {
        "type": "object",
        "properties": {
          "workout_type": {"type": "string"},
          "duration_minutes": {"type": "integer"},
          "intensity": {"type": "string"},
          "notes": {"type": "string"},
          "occurred_at": {"type": "string", "description": "ISO datetime"}
        },
        "required": ["workout_type"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "workout_type": {"type": "string"},
          "duration_minutes": {"type": "integer"}
        }
      },
      "function": "log_workout"
    },
    {
      "name": "workouts.get_workout_summary",
      "description": "Get recent workouts and recurring patterns",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {"type": "integer", "default": 20}
        },
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "recent_workouts": {"type": "array", "items": {"type": "object"}},
          "patterns": {"type": "array", "items": {"type": "object"}},
          "total_duration_minutes": {"type": "integer"}
        }
      },
      "function": "get_workout_summary"
    }
  ]
}
